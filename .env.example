# ==========================================
# CampusPulse AI — Environment Variables
# ==========================================

# Google Gemini API Key (Optional)
# Obtain from: https://aistudio.google.com/
# If left blank, CampusPulse AI automatically runs its resilient
# deterministic heuristic parsing engine with zero crashes.
GEMINI_API_KEY=your_gemini_api_key_here
# or GOOGLE_API_KEY=your_gemini_api_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME="CampusPulse AI"
NEXT_PUBLIC_CAMPUS_NAME="Apex Institute of Technology & Science"
NODE_ENV=production

